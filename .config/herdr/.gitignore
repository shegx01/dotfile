# ~/.config/herdr is both the config dir and herdr's runtime dir. Only the
# hand-written config is tracked; everything herdr generates is machine-local.

# Server/client logs and session state
*.log
session.json
session-history.json
release-notes.json
config.toml.bak-*
.plugins.lock

# Installed plugin payloads and the local plugin registry. plugins.json holds
# absolute paths and resolved commits for THIS machine, so it is regenerated by
# install-plugins.sh rather than committed.
plugins.json
plugins/github/

# Per-plugin runtime state (update checks, caches). Tracked plugin settings
# live in plugins/config/<plugin>/ and are committed explicitly.
plugins/config/*/update-check-state.json
plugins/config/*/cache/

# Agent tooling scratch dirs
.omc/
plugins/.omc/
